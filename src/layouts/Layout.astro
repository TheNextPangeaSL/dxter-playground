---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BuscaÓptimos — Dxter",
  description = "Demuestra el poder de la optimización bayesiana de Dxter encontrando el óptimo en un mapa oculto.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Inter, Space Grotesk, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body
    class="min-h-dvh bg-surface-900 text-slate-200 font-sans antialiased selection:bg-dxter-500/30 selection:text-white"
  >
    <!-- Subtle background pattern -->
    <div
      class="fixed inset-0 -z-10 opacity-[0.03]"
      style="background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.3) 1px, transparent 0); background-size: 32px 32px;"
    >
    </div>

    <!-- Ambient glow effects -->
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 -z-10 w-[800px] h-[600px] rounded-full opacity-10 blur-3xl pointer-events-none"
      style="background: radial-gradient(ellipse, var(--color-dxter-500), transparent 70%);"
    >
    </div>

    <main class="relative">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
